--[[
    Anti-Ban & Auto-Reconnect Kick Bypass
]]--

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local function BypassKickAndAutoRejoin()
    local oldKick
    oldKick = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if self == LocalPlayer and (method == "Kick" or method == "kick") then
            print("攔截到封鎖/踢出請求: " .. tostring(args[1]))
            
            task.spawn(function()
                task.wait(1)
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
            end)
            
            return nil
        end
        return oldKick(self, ...)
    end)

    CoreGui.ChildAdded:Connect(function(child)
        pcall(function()
            if child:IsA("ScreenGui") and (string.find(child.Name, "Error") or string.find(child.Name, "Prompt")) then
                for _, descendant in ipairs(child:GetDescendants()) do
                    if descendant:IsA("TextLabel") and (string.find(descendant.Text, "You have been permanently banned") or string.find(descendant.Text, "banned")) then
                        print("偵測到封禁畫面，正在自動重新加入遊戲...")
                        task.wait(0.5)
                        TeleportService:Teleport(game.PlaceId, LocalPlayer)
                    end
                end
            end
        end)
    end)
end

pcall(BypassKickAndAutoRejoin)
