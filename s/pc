--[[
    Blox Fruits UI Translation, Localization & Anti-Ban Rejoin Script
]]--

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TeleportService = game:GetService("TeleportService")

-- 1. 防踢出與自動重連機制
local function BypassKickAndAutoRejoin()
    pcall(function()
        local oldKick
        oldKick = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            
            if self == LocalPlayer and (method == "Kick" or method == "kick") then
                print("攔截到踢出/封鎖請求，正在自動重新加入...")
                task.spawn(function()
                    task.wait(1)
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, LocalPlayer)
                    end)
                end)
                return nil
            end
            return oldKick(self, ...)
        end)
    end)

    CoreGui.DescendantAdded:Connect(function(child)
        pcall(function()
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local txt = child.Text or ""
                if string.find(txt, "You have been permanently banned") or string.find(txt, "banned") or string.find(txt, "Disconnected") then
                    print("偵測到斷線或封禁提示，正在自動重新加入遊戲...")
                    task.wait(0.5)
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end
            end
        end)
    end)
end

pcall(BypassKickAndAutoRejoin)

