local function ApplyTranslation(obj)
    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        local originalText = obj.Text
        if TranslationDictionary[originalText] then
            obj.Text = TranslationDictionary[originalText]
        else
            for eng, zht in pairs(TranslationDictionary) do
                if string.find(originalText, eng) then
                    obj.Text = string.gsub(originalText, eng, zht)
                end
            end
        end

        obj:GetPropertyChangedSignal("Text"):Connect(function()
            local currentText = obj.Text
            if TranslationDictionary[currentText] then
                obj.Text = TranslationDictionary[currentText]
            else
                for eng, zht in pairs(TranslationDictionary) do
                    if string.find(currentText, eng) then
                        obj.Text = string.gsub(currentText, eng, zht)
                    end
                end
            end
        end)
    end
end

local function ScanGui(parent)
    for _, descendant in ipairs(parent:GetDescendants()) do
        pcall(function()
            ApplyTranslation(descendant)
        end)
    end
end

CoreGui.DescendantAdded:Connect(function(child)
    pcall(function()
        ApplyTranslation(child)
    end)
end)

if Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui") then
    Players.LocalPlayer.PlayerGui.DescendantAdded:Connect(function(child)
        pcall(function()
            ApplyTranslation(child)
        end)
    end)
    ScanGui(Players.LocalPlayer.PlayerGui)
end

ScanGui(CoreGui)
